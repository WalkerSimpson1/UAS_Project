# Copy to .env and fill in. .env is gitignored; never commit or print these values.
LEGI_API_KEY=
REGULATIONS_API_KEY=

POSTGRES_DB=uas_tracker
POSTGRES_USER=uas
POSTGRES_PASSWORD=
# Host-side connection for scripts run outside Docker.
DATABASE_URL=postgresql://uas:<password>@127.0.0.1:5432/uas_tracker

# Raw API responses (write-once), relative to the repo. Gitignored.
RAW_ROOT=./data/raw
